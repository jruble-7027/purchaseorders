rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated with Firebase
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check institutional domain
    function isWcaMember() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i).*@wcatrojans[.]org$') ||
        request.auth.token.email.matches('(?i).*@wesleyan[.]edu$')
      );
    }
    
    // Safely check if user is an accountant without crashing on missing user documents
    function isAccountant() {
      return isAuthenticated() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role in ['accountant', 'admin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'employee') in ['accountant', 'admin'])
      );
    }

    // User profile collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAccountant());
    }

    // Expense accounts reference list (e.g. ACCT-566400, ACCT-566425)
    match /expense_accounts/{accountId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Purchase orders collection
    match /purchase_orders/{poId} {
      // Any authenticated user can read POs (dashboard lists & status tracking)
      allow read: if isAuthenticated();
      
      // Allow creation if user is authenticated and matches creator UID or email
      allow create: if isAuthenticated() && (
        request.resource.data.created_by == request.auth.uid ||
        request.resource.data.employee_email == request.auth.token.email
      );
      
      // Employees can update their own PO; Accountants can update any PO
      allow update: if isAuthenticated() && (
        resource.data.created_by == request.auth.uid ||
        resource.data.employee_email == request.auth.token.email ||
        isAccountant()
      );

      // Only draft owners or accountants can delete
      allow delete: if isAuthenticated() && (
        (resource.data.created_by == request.auth.uid && resource.data.status == 'draft') ||
        isAccountant()
      );

      // Audit logs sub-collection for every PO
      match /audit_logs/{logId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if false; // Audit logs are immutable
      }
    }
  }
}
