rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAllowedFileType() {
      return request.resource.contentType == null ||
             request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/x-pdf') ||
             request.resource.contentType.matches('application/octet-stream');
    }
    
    function isValidFileSize() {
      return request.resource.size < 25 * 1024 * 1024; // 25 MB limit
    }

    match /receipts/{poNumber}/{fileName} {
      // Any authenticated user from the school can view receipts
      allow read: if isAuthenticated();
      
      // Allow upload only if authenticated, valid file type and under size limit
      allow create, update: if isAuthenticated() && isAllowedFileType() && isValidFileSize();
      allow delete: if isAuthenticated();
    }
  }
}
