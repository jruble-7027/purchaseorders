rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isWcaMember() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email.lower().matches('.*@(wcatrojans[.]org|wesed[.]org)$');
    }
    
    function isAllowedFileType() {
      return request.resource.contentType == null ||
             request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/x-pdf') ||
             request.resource.contentType.matches('application/octet-stream');
    }
    
    function isValidFileSize() {
      return request.resource.size < 25 * 1024 * 1024; // 25 MB limit
    }

    match /receipts/{poNumber}/{fileName} {
      // Only authenticated Wesleyan Christian Academy users can view receipts
      allow read: if isWcaMember();
      
      // Allow upload only if authenticated WCA user, valid file type and under size limit
      allow create, update: if isWcaMember() && isAllowedFileType() && isValidFileSize();
      allow delete: if isWcaMember();
    }
  }
}
